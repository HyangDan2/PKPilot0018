{
  "name": "pkpilot0018",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HD2Lab Sigrún — pure-browser statistical & quality workspace",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable": "node tools/build_portable.mjs",
    "preview": "vite preview --port 4178 --strictPort",
